    <!-- 1. Welcome -->
    <string name="welcome_title">FF Diamond</string>
    <string name="welcome_body">A fast, quiet home screen. Your apps in a clean grid, folders that
        actually feel good to make, and nothing watching you.</string>
    <string name="welcome_point_offline">Works fully offline — no network permission at all</string>
    <string name="welcome_point_no_tracking">No ads, no analytics, no account</string>
    <string name="welcome_point_optional">Every permission below is optional</string>
    <string name="get_started">Get started</string>

    <!-- 2. Required access -->
    <string name="required_title">Access it needs</string>
    <string name="required_body">Only one, and even this one is optional.</string>
    <string name="notifications_title">Notifications</string>
    <string name="notifications_body">Lets the launcher post its own notifications, such as a
        long-running app-list refresh. Nothing else uses it.</string>
    <string name="notifications_not_needed">Not required on this version of Android</string>
    <string name="app_list_title">Your app list</string>
    <string name="app_list_body">Reading your installed apps needs no permission at all. The
        launcher declares a &lt;queries&gt; block in its manifest instead, so Android hands over the
        list without ever prompting you.</string>

    <!-- 3. Optional access -->
    <string name="optional_title">Optional extras</string>
    <string name="optional_body">Skip anything you do not want. Skipping only turns off the one
        feature it belongs to — the launcher works either way.</string>
    <string name="notification_badges_title">Notification badges</string>
    <string name="notification_badges_body">Shows an unread count on app icons. Needs notification
        access, which is granted in Settings.</string>
    <string name="app_suggestions_title">App suggestions</string>
    <string name="app_suggestions_body">Puts your most-used apps at the top of search. Needs usage
        access, which is granted in Settings. Without it, search falls back to recently installed
        apps.</string>

    <!-- 4. Default launcher -->
    <string name="default_title">Set as default</string>
    <string name="default_body">The last step. Once Atmiya is your home app, pressing Home opens
        this launcher instead of your old one. You can switch back any time from Settings.</string>
    <string name="currently_default_yes">Currently default: yes</string>
    <string name="currently_default_no">Currently default: no</string>
    <string name="set_as_default">Set as default</string>
