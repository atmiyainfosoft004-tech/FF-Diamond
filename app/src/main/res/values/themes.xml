<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Home screen. The window itself is transparent and the system paints the user's wallpaper
      behind it, which is what makes wallpaper parallax possible in a later phase.
    -->
    <style name="Theme.AtmiyaLauncher.Home" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="colorSurface">@android:color/transparent</item>
        <item name="android:windowBlurBehindEnabled" tools:targetApi="s">true</item>
        <!-- 0 at rest so home stays sharp; DrawerController raises this while the drawer is open. -->
        <item name="android:windowBackgroundBlurRadius" tools:targetApi="s">0px</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>

        <!-- Edge to edge: the activity draws behind both bars and pads itself with the insets. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="28">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.AtmiyaLauncher.FunnelGuide" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBlurBehindEnabled" tools:targetApi="s">true</item>
        <item name="android:windowBackgroundBlurRadius" tools:targetApi="s">80px</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <style name="Theme.AtmiyaLauncher.Media" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="28">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

    <style name="Animation.Ff.Slide" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Theme.AtmiyaLauncher.Funnel" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowAnimationStyle">@style/Animation.Ff.Slide</item>
        <item name="colorPrimary">@color/ff_gradient_start</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ff_gradient_end</item>
        <item name="android:windowBackground">@color/ff_system_bar</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/ff_system_bar</item>
        <item name="android:statusBarColor">@color/ff_system_bar</item>
        <item name="android:navigationBarColor">@color/ff_system_bar</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="28">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="Widget.Atmiya.Button.Funnel" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/funnel_red</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <style name="TextAppearance.Atmiya.FunnelTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/funnel_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- FF Diamond text and widget styles -->
    <style name="TextAppearance.Ff.ScreenTitle" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/_20ssp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Ff.HomeTitle" parent="TextAppearance.Ff.ScreenTitle">
        <item name="android:textSize">@dimen/_22ssp</item>
        <item name="android:lineSpacingExtra">@dimen/_2sdp</item>
    </style>

    <style name="TextAppearance.Ff.Option" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Ff.Button" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/_15ssp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Ff" parent="android:Widget" />

    <style name="Widget.Ff.PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ff_button_height</item>
        <item name="android:background">@drawable/bg_btn_gradient</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Ff.Button</item>
    </style>

    <!-- Blue text action used by the onboarding "Next" / "Get Started" -->
    <style name="TextAppearance.Ff.TextAction" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/_17ssp</item>
        <item name="android:textColor">@color/ff_accent_light</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Ff.TileLabel" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/_15ssp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Ff.CardLabel" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Ff.Body" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textColor">@color/ff_text_muted</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Ff.OnboardTitle" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/_20ssp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Ff.OnboardBody" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/_15ssp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:lineSpacingExtra">@dimen/_1sdp</item>
    </style>

    <style name="TextAppearance.Ff.DetailBody" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:lineSpacingExtra">@dimen/_2sdp</item>
    </style>

    <!-- Onboarding wizard and the status screen. Opaque, dark, edge to edge. -->
    <style name="Theme.AtmiyaLauncher.Onboarding" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowAnimationStyle">@style/Animation.Ff.Slide</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_light</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/onboarding_top</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="28">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Shared text styles -->
    <style name="TextAppearance.Atmiya.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">@dimen/onboarding_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Atmiya.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">@dimen/card_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Atmiya.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/hint_text</item>
        <item name="android:textSize">@dimen/onboarding_body_size</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <!-- Bottom "Continue" button -->
    <style name="Widget.Atmiya.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/onboarding_button_height</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/on_light</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">@dimen/onboarding_button_corner</item>
        <item name="rippleColor">@color/card_stroke</item>
    </style>

    <!-- Skip / secondary text button -->
    <style name="Widget.Atmiya.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/hint_text</item>
    </style>

    <!-- Remove / Uninstall, the two targets that slide down while an icon is being dragged -->
    <style name="Widget.Atmiya.DropTarget" parent="android:Widget.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/space_sm</item>
        <item name="android:layout_marginEnd">@dimen/space_sm</item>
        <item name="android:background">@drawable/bg_drop_target</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/on_dark</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/drop_bar_target_padding</item>
        <item name="android:paddingBottom">@dimen/drop_bar_target_padding</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">@dimen/drop_bar_text_size</item>
    </style>

    <!-- Per-card CTA, e.g. "Turn on" inside an access card -->
    <style name="Widget.Atmiya.Button.Card" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:textSize">@dimen/chip_text_size</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="cornerRadius">@dimen/chip_corner_radius</item>
    </style>
</resources>
