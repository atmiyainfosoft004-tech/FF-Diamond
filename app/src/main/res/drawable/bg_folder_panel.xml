<?xml version="1.0" encoding="utf-8"?>
<!-- A translucent plate over the blurred wallpaper; the blur is what gives it its substance. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/folder_panel_fill" />
    <stroke
        android:width="@dimen/card_stroke_width"
        android:color="@color/card_stroke" />
    <corners android:radius="@dimen/folder_panel_corner" />
</shape>
