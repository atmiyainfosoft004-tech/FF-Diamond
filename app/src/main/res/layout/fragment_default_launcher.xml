<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/onboarding_page_padding"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_home_glyph" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/default_title"
            android:textAppearance="@style/TextAppearance.Atmiya.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/default_body"
            android:textAppearance="@style/TextAppearance.Atmiya.Body" />

        <TextView
            android:id="@+id/defaultStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_status_chip_pending"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/currently_default_no"
            android:textColor="@color/status_pending"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/defaultHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/default_pick_hint"
            android:textAppearance="@style/TextAppearance.Atmiya.Body" />
    </LinearLayout>
</ScrollView>
