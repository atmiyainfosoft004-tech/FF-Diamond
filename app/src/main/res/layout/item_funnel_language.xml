<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clLanguageCard"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_52sdp"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/selector_country_card"
    android:paddingHorizontal="@dimen/_12sdp">

    <ImageView
        android:id="@+id/imgLanguageFlag"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_flag_spain" />

    <TextView
        android:id="@+id/txtLanguageName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:singleLine="true"
        android:textColor="@color/ff_lang_title"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintBottom_toTopOf="@+id/txtLanguageNative"
        app:layout_constraintEnd_toStartOf="@+id/vRadio"
        app:layout_constraintStart_toEndOf="@+id/imgLanguageFlag"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Spanish" />

    <TextView
        android:id="@+id/txtLanguageNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textColor="@color/ff_lang_sub"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/txtLanguageName"
        app:layout_constraintStart_toStartOf="@+id/txtLanguageName"
        app:layout_constraintTop_toBottomOf="@+id/txtLanguageName"
        tools:text="Español" />

    <View
        android:id="@+id/vRadio"
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_16sdp"
        android:background="@drawable/selector_language_radio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
