<?xml version="1.0" encoding="utf-8"?>
<!--
  One permission, one card. Reused by the required page, the optional page and the status screen,
  so it always carries a live granted / not-granted chip rather than a static description.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cardIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_bell" />

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/notifications_title"
            android:textAppearance="@style/TextAppearance.Atmiya.CardTitle" />

        <TextView
            android:id="@+id/cardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_status_chip_pending"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/not_granted"
            android:textColor="@color/status_pending"
            android:textSize="@dimen/chip_text_size" />
    </LinearLayout>

    <TextView
        android:id="@+id/cardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/notifications_body"
        android:textAppearance="@style/TextAppearance.Atmiya.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cardAction"
        style="@style/Widget.Atmiya.Button.Card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/turn_on" />
</LinearLayout>
