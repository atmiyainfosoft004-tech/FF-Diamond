<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_screen"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingTop="@dimen/_14sdp"
    android:paddingBottom="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtHomeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ff_home_title"
            android:textAppearance="@style/TextAppearance.Ff.HomeTitle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/tileCharacters"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_116sdp"
                android:background="@drawable/bg_home_tile"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_170sdp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_home_characters" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/_18sdp"
                    android:text="@string/ff_characters"
                    android:textAppearance="@style/TextAppearance.Ff.TileLabel" />
            </FrameLayout>

            <include
                android:id="@+id/ad_native"
                layout="@layout/view_ad_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_minus6sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="2">

                <include
                    android:id="@+id/tilePets"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tileBundles"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tileWeapons"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tileVehicles"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tilePlay1"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tileEmotes"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tileCalculator"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tilePlay2"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tileParachutes"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />

                <include
                    android:id="@+id/tileTips"
                    layout="@layout/item_home_tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_112sdp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/_6sdp" />
            </GridLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
