<?xml version="1.0" encoding="utf-8"?>
<!--
  The wallpaper is the background: nothing here paints an opaque surface, and the theme makes the
  window itself transparent. The drag layer is the true root so a lifted icon can travel over
  pages, the dock and the action bar without being clipped by any of them.
-->
<com.example.ffdiamond.ui.drag.DragLayer
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drag_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    tools:context=".LauncherActivity">

    <ImageView
        android:id="@+id/drawer_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:layerType="hardware"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <com.example.ffdiamond.ui.workspace.HomeRootLayout
        android:id="@+id/launcher_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.example.ffdiamond.ui.workspace.Workspace
            android:id="@+id/workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--
              Page -1. A container rather than real content: it exists so a feed, a news panel or a
              search surface can be dropped in as a fragment without touching the pager.
            -->
            <FrameLayout
                android:id="@+id/feed_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Workspace grid pages are inserted between these two containers at runtime. -->

            <FrameLayout
                android:id="@+id/downloader_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.example.ffdiamond.ui.workspace.Workspace>

        <com.example.ffdiamond.ui.workspace.PageIndicatorView
            android:id="@+id/page_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="16dp" />

        <com.example.ffdiamond.ui.workspace.CellLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="16dp" />

    </com.example.ffdiamond.ui.workspace.HomeRootLayout>

    <com.example.ffdiamond.ui.drag.DropActionBar
        android:id="@+id/drop_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:paddingStart="@dimen/sheet_padding"
        android:paddingEnd="@dimen/sheet_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm" />

    <com.example.ffdiamond.ui.drawer.DrawerOverlay
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <com.example.ffdiamond.widget.WidgetResizeOverlay
        android:id="@+id/widget_resize"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.example.ffdiamond.ui.folder.FolderPanel
        android:id="@+id/folder_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/launcher_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app_screen"
        android:elevation="80dp"
        android:visibility="gone" />

</com.example.ffdiamond.ui.drag.DragLayer>
