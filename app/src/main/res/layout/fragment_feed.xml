<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llFeedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_surface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llFeedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/feed_surface"
        android:elevation="@dimen/_4sdp"
        android:orientation="vertical"
        android:paddingStart="@dimen/card_side_margin"
        android:paddingTop="@dimen/_12sdp"
        android:paddingEnd="@dimen/card_side_margin"
        android:paddingBottom="@dimen/_8sdp">

        <TextView
            android:id="@+id/txtFeedHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feed_title"
            android:textColor="@color/on_light"
            android:textSize="@dimen/_24ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFeedHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="@string/feed_subtitle"
            android:textColor="@color/feed_meta"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeedList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="ifContentScrolls" />

        <ProgressBar
            android:id="@+id/pbFeedLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llFeedErrorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtFeedError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/feed_error"
                android:textColor="@color/on_light"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/btnFeedRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/bg_feed_chip"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:text="@string/feed_retry"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
