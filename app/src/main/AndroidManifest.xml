        <!-- Opens when the user taps the app icon: onboarding wizard, then the status screen. -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AtmiyaLauncher.Onboarding"
            android:windowSoftInputMode="adjustResize" />

        <!--
          The home screen itself. Never shows onboarding, never finishes.

          screenOrientation is "nosensor" rather than "portrait": the grid is designed as a single
          portrait frame and a landscape home screen is a different layout, not the same one
          rotated, but a tablet's natural orientation is landscape and hard-coding portrait would
          fight it.
        -->
        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation|uiMode|density"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.AtmiyaLauncher.Home"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Stub listener declared in Phase 1 so the app appears in
          Settings > Notification access and the toggle is actually grantable.
          Badge counting is wired up in a later phase.
        -->
        <service
            android:name=".service.BadgeNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_badges_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.SearchWidgetClickReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.SearchWidgetProvider"
            android:exported="true"
            android:label="@string/search_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_info" />
        </receiver>


